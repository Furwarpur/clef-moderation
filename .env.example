# clef2の実行設定。このサンプルは本番前のオンライン調整用です。
# 変更後は環境変数を読み込み直してworkerを再起動してください。
# 本番当日: TUNABLEOP_TUNINGを0、INFERENCE_TIMEOUT_SECONDSを30に変更。
# TUNABLEOP_ENABLEDは1のまま、同じCSVを使って再起動してください。

# 必須: 判定タスクを受信し、結果を返信するバックエンドのWebSocket URL。
# 外部接続はwssを使用。パスは/ws/moderation、トークンはURLに含めません。
MODERATION_URL=wss://live-api-dev.sohosai.com/ws/moderation

# 必須: バックエンドと共通の認証トークン。
# WebSocket接続時にbearer.<token>として送信。このファイルの実値はGit管理しません。
MODERATION_TOKEN=replace-with-shared-backend-token

# 1件の推論時間上限（秒）。正の有限数。未指定時は30。
# モデル読み込み・キュー待ちは除外。超過時はreview送信を試み、workerを再起動します。
# 本番前は初回調整に時間がかかるため600。本番当日は30へ戻してください。
CLEF_INFERENCE_TIMEOUT_SECONDS=600

# 待機タスクの上限（正の整数、未指定時16）。推論中の1件は含めません。
# 満杯時は新着タスクをキューへ追加せずreviewを返信し、既存タスクを処理し続けます。
CLEF_QUEUE_CAPACITY=16

# 保存済みGPU調整結果を使うスイッチ（0または1、未指定時1）。
# 本番前・当日とも1を維持。0ではCSVに保存した調整結果も使われません。
PYTORCH_TUNABLEOP_ENABLED=1

# 未調整のGPU計算方法を追加測定するスイッチ（0または1、未指定時0）。
# 本番前は1: 新しい調整結果をCSVへ保存します。初回の処理時間が大きく伸びます。
# 本番当日は0: 追加測定を止め、保存済みの結果を再利用します。
PYTORCH_TUNABLEOP_TUNING=1

# 調整結果の読み込み・保存先。相対パスは起動場所によらずclef2ディレクトリ基準です。
# 絶対パスも指定可能。保存先はclef2/runtime配下に限り、未指定時はruntime/tunableop.csv。
# ファイル不在・形式不正・環境非互換では起動しません。
# 原本のtunableop-original.csvは指定せず、本番当日も同じ作業CSVを使ってください。
PYTORCH_TUNABLEOP_FILENAME=runtime/tunableop.csv

